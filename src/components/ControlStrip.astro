---
// library imports
import { getCollection, type CollectionEntry } from "astro:content";

// utils imports
import { formatBlogPosts, slugify } from "../js/utils";

// Mac OS 9 Control Strip: a compact, collapsible sitewide launcher for
// windows, the blog, and its published categories. Items with a `popup` id
// reuse the exact href="#popup1".."#popup4" convention WindowManager.astro
// already listens for -- these are the same links used elsewhere (the Help
// menu's Privacy Policy link, the media sidebar icons), just restyled as
// strip modules. WindowManager toggles the window and announces the
// change; this component only listens for that announcement to keep each
// module's pressed/active look in sync.
//
// "About Mack" is the odd one out: it opens the MackOS 9.0 window
// (#hero-window) rather than the About popup, and isn't a toggle -- it
// always ensures the window is open, so it has no `popup` id to sync an
// active state against.
//
const posts: CollectionEntry<"blog">[] = formatBlogPosts(await getCollection("blog"));
const categories = [...new Set(posts.map((post) => post.data.category))]
  .sort((a, b) => a.localeCompare(b));

const items: {
  href: string;
  title: string;
  popup?: string;
  icon?: string;
  categoryIcon?: string;
}[] = [
  {
    href: "/#hero-window",
    title: "About Mack",
    icon: "/assets/images/mack-headshot-8bit-color-small.png",
  },
  {
    popup: "popup3",
    href: "#popup3",
    title: "Mackintosh HD",
    icon: "/assets/images/hard-drive.png",
  },
  {
    href: "/blog/",
    title: "Blog",
    icon: "/assets/images/book-red.png",
  },
  ...categories.map((title) => {
    const slug = slugify(title);
    return { href: `/category/${slug}/`, title, categoryIcon: slug };
  }),
];
---

<nav class="control-strip" aria-label="Control Strip">
  <div id="control-strip-items" class="control-strip__items">
    {
      items.map((item) => (
        <a
          href={item.href}
          class="control-strip__item"
          data-popup={item.popup}
          aria-label={item.title}
          title={item.title}
        >
          {item.icon
            ? <img src={item.icon} alt="" />
            : <span class:list={["control-strip__category-icon", "icon", item.categoryIcon]} aria-hidden="true"></span>}
        </a>
      ))
    }
  </div>
  <button
    type="button"
    class="control-strip__tab"
    aria-label="Collapse Control Strip"
    aria-controls="control-strip-items"
    aria-expanded="true">
    <span class="control-strip__tab-arrow" aria-hidden="true"></span>
  </button>
</nav>

<style>
  .control-strip {
    align-items: stretch;
    background-color: hsl(var(--color-mid), 1);
    border-radius: 0;
    bottom: 0;
    box-shadow:
      0 0 0 1px hsl(var(--color-dark), 1),
      inset -1px -1px 0 1px hsl(var(--color-dark), 0.25),
      inset 1px 1px 0 2px hsl(var(--color-light), 0.5),
      2px 2px 6px hsl(var(--color-dark), 0.35);
    display: flex;
    left: 0;
    max-width: 100%;
    position: fixed;
    z-index: 999999;
  }
  .control-strip__tab {
    all: unset;
    align-items: center;
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    flex: 0 0 auto;
    justify-content: center;
    padding: 0;
  }
  .control-strip__tab-arrow {
    border-bottom: 5px solid transparent;
    border-right: 6px solid hsl(var(--color-dark), 1);
    border-top: 5px solid transparent;
    display: block;
    height: 0;
    margin: 0 8px;
    width: 0;
  }
  .control-strip.collapsed .control-strip__tab-arrow {
    border-left: 6px solid hsl(var(--color-dark), 1);
    border-right: none;
  }
  .control-strip__items {
    display: flex;
    overflow: auto hidden;
    transition:
      width 0.25s ease,
      opacity 0.2s ease;
  }
  .control-strip.collapsed .control-strip__items {
    opacity: 0;
    overflow: hidden;
    width: 0;
  }
  .control-strip__item {
    align-items: center;
    border-right: 1px solid hsl(var(--color-dark), 0.2);
    display: flex;
    flex: 0 0 auto;
    flex-direction: column;
    justify-content: center;
    padding: 8px 10px;
    text-decoration: none;
    width: 72px;
  }
  .control-strip__item img {
    display: block;
    height: auto;
    width: 36px;
  }
  .control-strip__category-icon {
    background-size: contain;
    width: 36px;
    height: 36px;
  }
  @media (max-width: 420px) {
    .control-strip__item {
      padding: 6px 7px;
      width: 58px;
    }
    .control-strip__item img {
      width: 26px;
    }
  }
  .control-strip__item.active {
    background-color: hsl(var(--color-selection), 1);
    box-shadow: inset 1px 1px 3px hsla(0, 0%, 0%, 0.6);
  }
</style>

<script>
  const strip = document.querySelector<HTMLElement>(".control-strip");
  const tab = strip?.querySelector<HTMLElement>(".control-strip__tab");
  const modules = strip?.querySelector<HTMLElement>(".control-strip__items");

  tab?.addEventListener("click", () => {
    const collapsed = strip!.classList.toggle("collapsed");
    tab.setAttribute("aria-expanded", String(!collapsed));
    tab.setAttribute("aria-label", collapsed ? "Expand Control Strip" : "Collapse Control Strip");
    modules!.inert = collapsed;
  });

  const items = new Map<string, HTMLElement>();
  document
    .querySelectorAll<HTMLElement>(".control-strip__item[data-popup]")
    .forEach((item) => {
      const id = item.dataset.popup;
      if (id) items.set(id, item);
    });

  window.addEventListener("wm:popup-toggle", (event) => {
    const { id, isOpen } = (
      event as CustomEvent<{ id: string; isOpen: boolean }>
    ).detail;
    items.get(id)?.classList.toggle("active", isOpen);
  });
</script>
