---
// component imports
import AppleMenu from "./Nav-AppleMenu.astro";
import ContactLinks from "./Nav-ContactLinks.astro";
import CategoryCloud from "./Nav-CategoryCloud.astro";
import SocialShare from "./Nav-SocialShare.astro";
import SpecialLinks from "./Nav-SpecialLinks.astro";

// data imports
import * as site from "../data/site.json";

const { author } = site;
---

<header class="site__header">
  <nav aria-label="Main navigation">
  <ul class="site__nav">
    <AppleMenu />
    <li><a href="/" title="Home">Home</a></li>
    <li>
      <button type="button" aria-expanded="false" aria-controls="contact-menu">Contact</button>
      <ul id="contact-menu" class="submenu">
        <ContactLinks />
      </ul>
    </li><!-- end: Contact -->
    <li>
      <button type="button" aria-expanded="false" aria-controls="share-menu">Share</button>
      <ul id="share-menu" class="submenu">
        <SocialShare />
      </ul>
    </li><!-- end: Share -->
    <li>
      <button type="button" aria-expanded="false" aria-controls="web-ring-menu">Web Ring</button>
      <ul id="web-ring-menu" class="submenu">
        <SpecialLinks />
      </ul>
    </li><!-- end: Web Ring -->
    <li>
      <button type="button" aria-expanded="false" aria-controls="categories-menu">Categories</button>
      <CategoryCloud />
    </li><!-- end: Files -->
    <li>
      <button type="button" aria-expanded="false" aria-controls="help-menu">Help</button>
      <ul id="help-menu" class="submenu">
        <li><a href="#popup4" title="">Privacy Policy</a></li>
        <li><hr /></li>
        <li class="info">
          &copy; <span id="copyright-year">{new Date().getFullYear()}</span>. {
            author
          }. All Rights Reserved.
        </li>
      </ul>
    </li><!-- end: Help -->
    <li id="site-clock" aria-live="off"></li>
  </ul>
</nav>
</header>

<script is:inline>
  // The build-time year above is the no-JS fallback; keep it current for
  // long-lived tabs / infrequently rebuilt deploys.
  var y = document.getElementById("copyright-year");
  if (y) y.textContent = new Date().getFullYear();

  // Classic Mac menu-bar clock. There's no meaningful no-JS fallback for a
  // live clock on a static site, so the element just stays empty without JS.
  var clock = document.getElementById("site-clock");
  if (clock) {
    var updateClock = function () {
      var now = new Date();
      var month = String(now.getMonth() + 1).padStart(2, "0");
      var day = String(now.getDate()).padStart(2, "0");
      var date = month + "/" + day + "/" + now.getFullYear();
      var hours = now.getHours() % 12 || 12;
      var minutes = String(now.getMinutes()).padStart(2, "0");
      var ampm = now.getHours() >= 12 ? "PM" : "AM";
      clock.textContent = date + " " + hours + ":" + minutes + " " + ampm;
    };
    updateClock();
    setInterval(updateClock, 1000 * 15);
  }
</script>

<script>
  document.querySelectorAll<HTMLElement>(".site__nav > li").forEach(item => {
    const trigger = item.querySelector<HTMLButtonElement>(":scope > button");
    if (!trigger) return;
    const setOpen = (open: boolean) => {
      item.dataset.open = String(open);
      trigger.setAttribute("aria-expanded", String(open));
    };
    setOpen(false);
    item.addEventListener("pointerenter", () => setOpen(true));
    item.addEventListener("pointerleave", () => {
      if (!item.contains(document.activeElement)) setOpen(false);
    });
    trigger.addEventListener("click", event => setOpen(event.detail > 0 || item.dataset.open !== "true"));
    item.addEventListener("focusout", event => {
      if (!(event.relatedTarget instanceof Node) || !item.contains(event.relatedTarget)) setOpen(false);
    });
    item.addEventListener("keydown", event => {
      if (event.key === "Escape") {
        setOpen(false);
        trigger.focus();
        event.preventDefault();
      } else if (event.key === "ArrowDown" && event.target === trigger) {
        setOpen(true);
        item.querySelector<HTMLAnchorElement>(".submenu a")?.focus();
        event.preventDefault();
      }
    });
  });
</script>

<style is:global>
  .site__header > nav { width: 100%; height: 100%; }
  .site__nav button { background: none; border: 0; border-radius: 0; font: inherit; }

  img.filter-green {
    filter: grayscale(100%) brightness(80%) sepia(300%) hue-rotate(75deg)
      saturate(800%);
  }
  img.filter-gray {
    filter: grayscale(100%);
  }
  header.site__header {
    background-color: hsl(var(--color-base), 1);
    border-bottom: 1px solid hsl(var(--color-dark), 1);
    box-shadow: 0 1px 2px hsl(var(--color-dark), 1);
    display: flex;
    flex-grow: 1;
    font-family: var(--font-sans);
    height: 28px;
    position: fixed;
    inset: 0 0 auto 0;
    /* WindowManager.astro's bringToFront() starts windows at z-index 1000
       and keeps incrementing every time one is opened or clicked -- any
       fixed value in that range eventually loses to an open window,
       burying the menu bar (and its dropdown submenus, which inherit this
       stacking context) behind it. The real Mac OS menu bar always sits
       above every window, so this uses the max safe z-index rather than
       guessing a number windows will never reach. */
    z-index: 2147483647;
  }
  .site__nav {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    font-size: 0.9rem;
    height: 100%;
    list-style-position: unset;
    justify-content: center;
    margin: 0;
    padding: 0;
    width: 100%;
  }
  .site__nav li {
    align-items: center;
    color: hsl(var(--color-dark), 1);
    display: flex;
    font-size: 0.75rem;
    height: 100%;
    justify-content: center;
    margin: 0;
    padding: 0;
  }
  .site__nav :is(a, button) {
    color: hsl(var(--color-dark), 1);
    align-items: center;
    display: flex;
    height: 100%;
    justify-content: center;
    margin: 0;
    padding: 0 0.5rem;
    text-decoration: none;
    width: 100%;
  }
  .site__nav li:hover > :is(a, button),
  .site__nav li[data-open="true"] > button,
  .site__nav a:active,
  .site__nav :is(a, button):focus-visible {
    background-color: hsl(var(--color-selection), 1);
    color: hsl(var(--color-light), 1);
    cursor: pointer;
  }
  .site__nav hr {
    margin: 0;
  }
  .site__nav img {
    height: 16px;
    width: 16px;
  }
  .site__nav li#apple-menu img {
    height: 24px;
    width: 24px;
  }
  .site__nav .menu {
    position: relative;
  }
  .site__nav .submenu {
    background-color: hsl(var(--color-base), 1);
    border: 2px solid hsl(var(--color-dark), 1);
    box-shadow: 0 2px 2px hsl(var(--color-dark), 1);
    font-size: inherit;
    margin: 0;
    padding: 0;
    position: absolute;
    top: 99%;
    visibility: hidden;
    z-index: 100;
  }
  .site__nav li#apple-menu .submenu {
    left: 0;
    max-width: 50ch;
  }
  .site__nav li[data-open="true"] > .submenu,
  .site__nav li:not([data-open]):is(:hover, :focus-within) > .submenu {
    visibility: visible;
  }
  .site__nav .submenu li {
    padding: 0 !important;
  }
  .site__nav .submenu li.info {
    padding: 0.5rem 1rem !important;
  }
  .site__nav .submenu li.active > a {
    background-color: hsl(var(--color-selection), 1);
    color: hsl(var(--color-light), 1);
  }
  .site__nav .submenu li a {
    display: flex;
    justify-content: flex-start;
    margin: 0;
    padding: 0.5rem 1rem;
  }
  .site__nav .submenu li a img {
    display: block;
    float: left;
    height: 16px;
    margin-right: 0.5rem;
    position: relative;
    width: 16px;
  }
  .site__nav #site-clock {
    align-items: center;
    display: flex;
    font-size: 0.75rem;
    height: 100%;
    margin-left: auto;
    padding: 0 1rem;
    position: relative;
    text-wrap: nowrap;
  }
  #site-clock:empty {
    display: none;
  }
  #site-clock::before {
    background: url("/assets/images/dot-separator.png") no-repeat 50%;
    content: "";
    height: 100%;
    position: absolute;
    inset: auto auto auto -10px;
    width: 15px;
  }
  @media only screen and (max-width: 700px) {
    #site-clock {
      opacity: 0;
      width: 0;
    }
  }
</style>
