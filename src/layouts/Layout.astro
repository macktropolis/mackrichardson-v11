---
import BaseHead from "../components/BaseHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import BaseEnd from "../components/BaseEnd.astro";
import Media from "../components/Media.astro";
import ControlStrip from "../components/ControlStrip.astro";
import WindowManager from "../components/WindowManager.astro";
import About from "../components/Popup-About.astro";
import CategoryList from "../components/CategoryPicker.astro";
import Privacy from "../components/Popup-Privacy.astro";
import NewtonShell from "../components/NewtonShell.astro";

const { title, description, page, categorySlug, postURL } = Astro.props;
const url = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
	<BaseHead
		title={title ?? "Mack Richardson"}
		description={description}
		postURL={postURL}
	/>
	<body class={categorySlug ?? ""}>
	<SiteHeader
		title={title ?? "Mack Richardson"}
		url={url}
		page={page ?? "Home"}
		description={description}
	/>

		<Media />
		<ControlStrip />
		<NewtonShell title={title ?? "Home"} />
		<slot />
	<BaseEnd />

	<div id="popup1" class="popup" role="dialog" aria-label="About Mack Richardson" aria-hidden="true" inert>
		<About />
	</div>
	<div id="popup3" class="popup" role="dialog" aria-label="Mackintosh HD" aria-hidden="true" inert>
		<CategoryList />
	</div>
	<div id="popup4" class="popup" role="dialog" aria-label="Privacy Policy" aria-hidden="true" inert>
		<Privacy />
	</div>
	<WindowManager />
	</body>
	<!-- <Snow /> -->
</html>
